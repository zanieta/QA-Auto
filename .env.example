# Azure AI
AZURE_AI_ENDPOINT=https://<your-project>.openai.azure.com/
AZURE_AI_API_KEY=<your-azure-ai-key>
AZURE_AI_DEPLOYMENT=gpt-4o
# Optional per-role overrides — both fall back to AZURE_AI_DEPLOYMENT.
# Translator (text-only step -> JSON actions) can run on a cheap/fast model;
# the evaluator needs a vision-capable model. gpt-5.x reasoning models work:
# the client auto-drops `temperature` when a deployment rejects it.
AZURE_AI_TRANSLATOR_DEPLOYMENT=gpt-5.4-mini
# Do NOT put a mini/nano-tier model here. On dense multi-frame checklists a
# mini evaluator returned 3/3 fail then 3/3 pass on byte-identical input
# (2026-07-03); gpt-4o judged the same input 3/3 consistently. Evaluator
# verdicts are silent — they go straight to QMetry and can file Jira bugs — so
# the tier that flip-flops is the one you can least afford here.
# gpt-4.1 is the CURRENT evaluator (migrated 2026-08-13, measured via
# scripts/prompt_eval/: 5/5 pass, 0% flip rate on the unmodified prompt).
# gpt-4o is deprecated in Azure but still deployed, so clearing this line is
# the one-step revert. Leave this SET — unset means both roles fall back to
# AZURE_AI_DEPLOYMENT, which silently abandons the measured configuration.
AZURE_AI_EVALUATOR_DEPLOYMENT=gpt-4.1
# Which file under /prompts/ the evaluator's system prompt loads from.
# Defaults to result_evaluator.txt (tuned for gpt-4o) when unset. A candidate
# variant for a different evaluator model (e.g. result_evaluator_41.txt for
# gpt-4.1) must be validated with scripts/prompt_eval/ before flipping this.
#EVALUATOR_PROMPT_FILE=result_evaluator.txt
# Override if a newer model demands a newer API version (default 2024-08-01-preview)
#AZURE_AI_API_VERSION=2025-04-01-preview

# QMetry
# NOTE: there is deliberately no QMETRY_BASE_URL here. The client talks to
# https://qtmcloud.qmetry.com (see agent/qmetry.py), NOT the Jira host.
QMETRY_API_KEY=<your-qmetry-api-key>
# REQUIRED for the rail's test-run / test-case browser: it is the projectId
# filter on both catalogue searches. QMetry silently IGNORES a filter it
# cannot use, so a missing/blank value does not error — the rail just returns
# the wrong set. Find it in the QMetry UI URL or via scripts/qmetry_probe.py.
QMETRY_PROJECT_ID=<your-qmetry-numeric-project-id>
# Expands a shorthand search ("2075") into the full key QMetry matches on.
# Falls back to JIRA_PROJECT_KEY when unset, which is the same project.
#QMETRY_PROJECT_KEY=SOUSCLOUD
# Cycle the console opens by default (override per-tab with ?cycle=<idOrKey>)
#QMETRY_DEFAULT_CYCLE=1ZwYH2ObF7AGZa
# edit  = write results into the case's existing execution (default)
# create = create a new execution run in the same cycle on each push
QMETRY_EXECUTION_MODE=edit

# Jira (Atlassian)
JIRA_BASE_URL=https://dukemanufacturing.atlassian.net
JIRA_EMAIL=<your-atlassian-email>
JIRA_API_TOKEN=<your-atlassian-api-token>
JIRA_PROJECT_KEY=SOUSCLOUD
JIRA_BUG_ISSUE_TYPE=Bug

# Target app
APP_BASE_URL=https://<sous-chef-cloud-uat-url>
APP_USERNAME=<test-user-email>
APP_PASSWORD=<test-user-password>
# Both APP_BASE_URL and the login above are the LOWEST-precedence fallback.
# A tester can override either from the console without touching .env or
# restarting: the target URL via POST /settings/target-url, the login via
# POST /settings/credentials — both persisted to settings.json (gitignored).
# See agent/settings.py for the full precedence chain.

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Behaviour flags
HEADLESS=true
SCREENSHOT_ON_PASS=false
AUTO_CREATE_BUGS=false
RUN_MODE=continue
LOG_LEVEL=INFO
# Pause before a case's first action, so the URL banner + initial page are
# visible to a tester watching live. Default 3 (seconds); 0 disables. Skipped
# entirely when HEADLESS=true (there is no visible page to pause for).
#AGENT_LAUNCH_DELAY_S=3
# Retries for a failed browser action (re-snapshot + re-translate) before the
# step is marked FAIL. Default 3.
#STEP_MAX_ATTEMPTS=3
# How many of a step's captured frames reach the vision evaluator. Base64 PNGs
# dominate evaluation token cost, so this is the largest cost lever in a run —
# bigger than the model tier. The LAST n frames are kept, so the settled end
# state is always included. Default 8; values below 1 are clamped to 1.
#EVAL_MAX_FRAMES=8
